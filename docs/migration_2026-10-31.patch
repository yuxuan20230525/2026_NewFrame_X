--- template/TDT_Task/src/gimbal.cpp
+++ migrated/TDT_Task/src/gimbal.cpp
@@ -0,0 +1,98 @@
+#include "stm32f4xx.h"                  // Device header
+#include "gimbal.h"
+#include "lk_motor.h"
+#include "my_math.h"
+#include "dbus.h"
+
+namespace 
+{
+	constexpr float Max_Encoder = 65536.0f;
+	constexpr float Encoder_to_Deg = 360/Max_Encoder;
+	
+	constexpr float Pitch_Max_Speed = 30.0f ;//单位°每秒
+	constexpr float Yaw_Max_Speed = 30.0f ;//单位°每秒
+	
+	constexpr float kRcFullScale = 660.0f;
+	constexpr float kPitchMinDeg = 61000.0f * Encoder_to_Deg;
+	constexpr float kPitchMaxDeg = 6692.0f * Encoder_to_Deg;
+	
+	// Yaw不过零点
+	constexpr float kYawMinDeg = 1000.0f  * Encoder_to_Deg;
+	constexpr float kYawMaxDeg = 20000.0f * Encoder_to_Deg;
+	
+}
+Gimbal gimbal;
+
+void Gimbal::Get_CMD(void)
+{
+	cmd.Flag = RC.Key.SW[3] == RCS::Down?true:false;//RC.Key.SW[3]
+	cmd.Pitch_CMD_Speed_DPS = RC.Key.CH[2] / kRcFullScale;
+	cmd.Yaw_CMD_Speed_DPS = RC.Key.CH[3] / kRcFullScale;
+}
+
+void Gimbal::State_Change(void)
+{
+	switch(state)
+	{
+		case Disbale_Waiting :
+		{
+			if(dbusOfflineFlag == 0&&cmd.Flag == true)
+			{
+				state = Enable_Waiting;
+			}
+			break;
+		}
+		case Enable_Waiting :
+		{
+			if(cmd.Pitch_CMD_Speed_DPS != 0 ||cmd.Yaw_CMD_Speed_DPS != 0)
+			{
+				state = Enable_Working;
+			}
+			if(dbusOfflineFlag == 1||gimbal.cmd.Flag == false)
+			{
+				state = Disbale_Waiting;
+			}
+			break;
+		}
+		case Enable_Working :
+		{
+			if(dbusOfflineFlag == 1||cmd.Flag == false)
+			{
+				state = Disbale_Waiting;
+			}
+			break;
+		}
+	}
+}
+
+//void Gimbal::Update_Location
+//{
+//	
+//}
+void Gimbal::Init(void)
+{
+	Motor_Yaw = new LK_Motor(MHF7015, CAN1, 0x141);
+	Motor_Pitch = new LK_Motor(MHF7015, CAN1, 0x142);
+}
+
+void Gimbal::Update(void)
+{
+	Get_CMD();
+	State_Change();
+	switch(state)
+	{
+		case Disbale_Waiting :
+		{
+			
+			break;
+		}
+		case Enable_Waiting :
+		{
+			break;
+		}
+		case Enable_Working :
+		{
+			break;
+		}
+	} 
